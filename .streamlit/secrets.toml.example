# Plantilla de secrets — COPIAR a .streamlit/secrets.toml para desarrollo local,
# o pegar estos mismos valores en Streamlit Cloud (Settings → Secrets).
# El archivo real (.streamlit/secrets.toml) está en .gitignore: NO se sube al repo.

# Contraseña del panel de administración
ADMIN_PASSWORD = "pon-aqui-la-contraseña-real"

# Persistencia (Supabase) — parche temporal mientras la app vive en Streamlit Cloud
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_KEY = "TU-SERVICE-ROLE-KEY"
